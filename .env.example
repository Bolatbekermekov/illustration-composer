# Ключ Claude API (необязателен: без него сценарий 1 работает на офлайн-анализе)
ANTHROPIC_API_KEY=
# Модель и уровень рассуждений для анализа метафор
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Таймаут запроса к модели, мс
LLM_TIMEOUT_MS=25000
# Порт и адрес API-сервера
PORT=8787
HOST=127.0.0.1
# Лимит обращений к модели за окно (защита ключа на публичном демо); сверх лимита — офлайн-анализ
LLM_RATE_LIMIT=60
LLM_RATE_WINDOW_MS=3600000
